[gd_resource type="Theme" load_steps=6 format=3]

[sub_resource type="SystemFont" id="SystemFont_ui"]
font_names = PackedStringArray("Yu Gothic UI", "Yu Gothic", "Meiryo UI", "Meiryo", "MS Gothic", "Segoe UI")

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button"]
bg_color = Color(0.06, 0.16, 0.24, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.95, 1, 0.7)
skew = Vector2(0.25, 0)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_hover"]
bg_color = Color(0.1, 0.32, 0.45, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.95, 1, 1)
shadow_color = Color(0.35, 0.95, 1, 0.35)
shadow_size = 10
skew = Vector2(0.25, 0)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_pressed"]
bg_color = Color(0.2, 0.55, 0.7, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.95, 1, 0.7)
skew = Vector2(0.25, 0)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_frame"]
bg_color = Color(0.04, 0.06, 0.11, 0.94)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.95, 1, 1)
corner_radius_top_left = 22
corner_radius_top_right = 22
corner_radius_bottom_right = 22
corner_radius_bottom_left = 22
corner_detail = 1
shadow_color = Color(0.35, 0.95, 1, 0.18)
shadow_size = 18

[resource]
default_font = SubResource("SystemFont_ui")
Button/colors/font_color = Color(1, 1, 1, 1)
Button/colors/font_hover_color = Color(1, 1, 1, 1)
Button/colors/font_pressed_color = Color(0.95, 0.95, 0.95, 1)
Button/font_sizes/font_size = 22
Button/styles/hover = SubResource("StyleBoxFlat_button_hover")
Button/styles/normal = SubResource("StyleBoxFlat_button")
Button/styles/pressed = SubResource("StyleBoxFlat_button_pressed")
FramePanel/base_type = &"Panel"
FramePanel/styles/panel = SubResource("StyleBoxFlat_frame")
Label/colors/font_color = Color(0.96, 0.97, 0.98, 1)
